{
  "name": "capivara-rica",
  "version": "0.1.0",
  "private": true,
  "description": "Jogo gratuito, no navegador, que ensina juros compostos, cart\u00e3o, parcelamento e carreira para jovens brasileiros.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:check": "node --experimental-strip-types scripts/check-data.ts",
    "data:check:release": "node --experimental-strip-types scripts/check-data.ts --release",
    "size": "node --experimental-strip-types scripts/check-size.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  }
}
