{
  "name": "capivara-rica",
  "version": "0.1.0",
  "private": true,
  "description": "Jogo gratuito, no navegador, que ensina juros compostos, cartão, parcelamento e carreira para jovens brasileiros.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:check": "node --experimental-strip-types scripts/check-data.ts",
    "data:check:release": "node --experimental-strip-types scripts/check-data.ts --release",
    "size": "node --experimental-strip-types scripts/check-size.ts",
    "save:fixture": "WRITE_SAVE_FIXTURE=1 vitest run src/engine/migrate.test.ts",
    "ceilings": "node --experimental-strip-types scripts/check-ceilings.ts --self-test && node --experimental-strip-types scripts/check-ceilings.ts",
    "a11y": "node --experimental-strip-types scripts/a11y-audit.ts",
    "save:smoke": "node --experimental-strip-types scripts/save-smoke.ts",
    "lighthouse": "lhci autorun --config=lighthouserc.cjs"
  },
  "devDependencies": {
    "@lhci/cli": "0.16.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "@types/semver": "7.8.0",
    "axe-core": "4.14.0",
    "playwright": "1.65.0",
    "semver": "7.8.6",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  }
}
