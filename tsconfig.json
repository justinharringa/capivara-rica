{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "vite-plugin-pwa/client", "node"],
    "baseUrl": ".",
    "paths": {
      "$engine/*": ["src/engine/*"],
      "$ui/*": ["src/ui/*"],
      "$lib/*": ["src/lib/*"],
      "$data/*": ["data/*"],
      "$content/*": ["content/*"]
    }
  },
  "include": ["src/**/*", "scripts/**/*", "data/**/*.json", "content/**/*.json", "locales/**/*.json", "vite.config.ts"]
}
